# .env.production.example — copy to .env.production on the server and fill in every value.
# Never commit .env.production. Used by: docker compose -f docker-compose.prod.yml --env-file .env.production …

# Public hostname served by Caddy with automatic HTTPS (DNS A/AAAA record must point at this server).
# Use "localhost" only for a local test: Caddy then uses its own local certificate authority.
DOMAIN=kq.example.org

# Must be https://<DOMAIN>; mutations from any other origin are rejected (CSRF defence).
APP_URL=https://kq.example.org

# PostgreSQL credentials. The database is only reachable inside the Docker network.
# Generate a strong password, e.g.: openssl rand -base64 24 | tr -d '/+='
POSTGRES_DB=uscc
POSTGRES_USER=uscc
POSTGRES_PASSWORD=

# SRS-AUTH-04: hours of inactivity before a session ends (open question OI-06).
SESSION_IDLE_TIMEOUT_HOURS=16

# Backups (SRS §9: every ≤ 15 minutes on tournament days). Retention is open question OI-05.
BACKUP_INTERVAL_MINUTES=15
BACKUP_RETENTION_DAYS=14
