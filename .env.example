# .env.example — copy to .env and adjust before starting. Never commit .env.
# Every variable is explained in README.md → "Setup" → "Environment variables".

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────

# PostgreSQL connection URL used by Prisma and the app.
DATABASE_URL="postgresql://uscc:changeme@localhost:5432/uscc_dev?schema=public"

# Used by docker compose to initialise the PostgreSQL container. Must match DATABASE_URL.
POSTGRES_DB=uscc_dev
POSTGRES_USER=uscc
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Separate database for `pnpm test:integration`. Its name MUST contain "test"; the test helpers
# refuse to run otherwise, because they wipe every table between tests.
TEST_DATABASE_URL="postgresql://uscc:changeme@localhost:5432/uscc_test?schema=public"

# ──────────────────────────────────────────────
# Application and sessions
# ──────────────────────────────────────────────

# Public origin of the app (scheme://host[:port], no trailing slash).
# Mutating API requests whose Origin header differs are rejected (CSRF defence).
APP_URL="http://localhost:3000"

# SRS-AUTH-04: a session ends after this many hours without activity (open question OI-06; 16 proposed).
SESSION_IDLE_TIMEOUT_HOURS=16

# "true" forces the Secure flag on the session cookie. Leave unset: it is on automatically in production
# and off in development (browsers drop Secure cookies on plain-http localhost).
# SESSION_COOKIE_SECURE=true

NODE_ENV=development

# ──────────────────────────────────────────────
# Demo seed accounts (pnpm db:seed) — local development only
# ──────────────────────────────────────────────

# Optional overrides for the demo accounts created by the seed script. Defaults are listed in README.md.
# SEED_TD_USERNAME=td_demo
# SEED_TD_PASSWORD=
# SEED_RECORDER_USERNAME=recorder_demo
# SEED_RECORDER_PASSWORD=

# ──────────────────────────────────────────────
# Error tracking (optional, wired in Phase 5)
# ──────────────────────────────────────────────

# Sentry DSN. Leave empty to disable.
SENTRY_DSN=""
