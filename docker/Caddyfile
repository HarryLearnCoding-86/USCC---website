# docker/Caddyfile
# Reverse proxy with automatic HTTPS (Let's Encrypt for a public domain; Caddy's local CA for DOMAIN=localhost).
# HTTPS only with HSTS (NFR-07). The SSE stream (/api/tournaments/*/events) is neither compressed nor buffered,
# so live updates reach the projection screen at once (SRS-PROJ-04).

{$DOMAIN} {
	@notEventStream not path /api/tournaments/*/events
	encode @notEventStream zstd gzip

	reverse_proxy app:3000 {
		# Flush every write immediately: required for Server-Sent Events.
		flush_interval -1
		header_up X-Forwarded-Proto {scheme}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}
